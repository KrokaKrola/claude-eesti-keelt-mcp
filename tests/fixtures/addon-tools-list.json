event: message
data: {"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"add_note","description":"Add a new note to Anki. Use model_names to see available note types and model_field_names to see required fields. Returns the note ID on success. IMPORTANT: Only create notes that were explicitly requested by the user.","inputSchema":{"properties":{"deck_name":{"title":"Deck Name","type":"string"},"model_name":{"title":"Model Name","type":"string"},"fields":{"additionalProperties":{"type":"string"},"title":"Fields","type":"object"},"tags":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Tags"},"allow_duplicate":{"default":false,"title":"Allow Duplicate","type":"boolean"}},"required":["deck_name","model_name","fields"],"title":"add_noteArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"add_noteDictOutput","type":"object"}},{"name":"add_notes","description":"Add multiple notes to Anki in a single batch sharing the same deck and model. Uses Anki's native batch API for atomic undo support. Supports partial success - individual failures don't affect others. IMPORTANT: Only create notes that were explicitly requested by the user. Returns summary counts (created, skipped, failed) and a per-note results array with status and note_id.","inputSchema":{"$defs":{"NoteEntry":{"description":"A single note to add in a batch.","properties":{"fields":{"additionalProperties":{"type":"string"},"description":"Field values as key-value pairs (e.g., {\"Front\": \"question\", \"Back\": \"answer\"})","title":"Fields","type":"object"},"tags":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"description":"Additional tags for this note (merged with shared tags)","title":"Tags"}},"required":["fields"],"title":"NoteEntry","type":"object"}},"properties":{"deck_name":{"title":"Deck Name","type":"string"},"model_name":{"title":"Model Name","type":"string"},"notes":{"items":{"$ref":"#/$defs/NoteEntry"},"title":"Notes","type":"array"},"tags":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Tags"},"allow_duplicate":{"default":false,"title":"Allow Duplicate","type":"boolean"}},"required":["deck_name","model_name","notes"],"title":"add_notesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"add_notesDictOutput","type":"object"}},{"name":"card_management","description":"Manage card organization with 9 actions:\n\n    - reposition: Reposition NEW cards in the review queue (set learning order). Only works on NEW cards (queue=0). Non-new cards are silently skipped. Returns repositioned count.\n\n    - change_deck: Move cards to a different deck (creates deck if needed). Works with ANY card type. Returns moved count and deck_id.\n\n    - bury: Manually bury cards to hide them until the next day. Works with ANY card type. Returns buried count.\n\n    - unbury: Restore all buried cards in a specific deck. Unburies ALL buried cards in the specified deck. Returns deck_name.\n\n    - suspend: Suspend cards (hide from review indefinitely until unsuspended). Works with ANY card type. Returns suspended_count.\n\n    - unsuspend: Unsuspend cards (restore suspended cards to their previous queue). Only affects cards that are currently suspended. Returns unsuspended_count and card_ids.\n\n    - set_flag: Set or remove a colored flag on cards. Flag values: 0=none/remove, 1=red, 2=orange, 3=green, 4=blue, 5-7=custom. Returns flagged count.\n\n    - set_due_date: Set or change the due date for cards. Days: '0' = due now, '5' = due in 5 days, '5-7' = random range, '5!' = also reset interval. Returns affected_count and card_ids.\n\n    - forget_cards: Reset cards back to new state (forget scheduling). Options: restore_position (default true), reset_counts (default false). Returns affected_count and card_ids.","inputSchema":{"$defs":{"BuryParams":{"description":"Parameters for bury action.","properties":{"action":{"const":"bury","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to bury","items":{"type":"integer"},"title":"Card Ids","type":"array"}},"required":["action","card_ids"],"title":"BuryParams","type":"object"},"ChangeDeckParams":{"description":"Parameters for change_deck action.","properties":{"action":{"const":"change_deck","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to move","items":{"type":"integer"},"title":"Card Ids","type":"array"},"deck":{"description":"Target deck name (use '::' for nested, e.g., 'Spanish::Verbs')","title":"Deck","type":"string"}},"required":["action","card_ids","deck"],"title":"ChangeDeckParams","type":"object"},"ForgetCardsParams":{"description":"Parameters for forget_cards action.","properties":{"action":{"const":"forget_cards","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to reset to new state","items":{"type":"integer"},"title":"Card Ids","type":"array"},"restore_position":{"default":true,"description":"Restore original new-card position","title":"Restore Position","type":"boolean"},"reset_counts":{"default":false,"description":"Reset review and lapse counts","title":"Reset Counts","type":"boolean"}},"required":["action","card_ids"],"title":"ForgetCardsParams","type":"object"},"RepositionParams":{"description":"Parameters for reposition action.","properties":{"action":{"const":"reposition","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to reposition","items":{"type":"integer"},"title":"Card Ids","type":"array"},"starting_from":{"default":0,"description":"Starting position (0-based)","title":"Starting From","type":"integer"},"step_size":{"default":1,"description":"Increment between cards","title":"Step Size","type":"integer"},"randomize":{"default":false,"description":"Shuffle before assigning positions","title":"Randomize","type":"boolean"},"shift_existing":{"default":false,"description":"Push other cards forward","title":"Shift Existing","type":"boolean"}},"required":["action","card_ids"],"title":"RepositionParams","type":"object"},"SetDueDateParams":{"description":"Parameters for set_due_date action.","properties":{"action":{"const":"set_due_date","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to reschedule","items":{"type":"integer"},"title":"Card Ids","type":"array"},"days":{"description":"Due date string: '5' = due in 5 days, '5-7' = random range, '0' = due now, '5!' = set due AND reset interval","title":"Days","type":"string"}},"required":["action","card_ids","days"],"title":"SetDueDateParams","type":"object"},"SetFlagParams":{"description":"Parameters for set_flag action.","properties":{"action":{"const":"set_flag","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to flag","items":{"type":"integer"},"title":"Card Ids","type":"array"},"flag":{"description":"Flag value: 0=none/remove, 1=red, 2=orange, 3=green, 4=blue, 5-7=custom user flags","title":"Flag","type":"integer"}},"required":["action","card_ids","flag"],"title":"SetFlagParams","type":"object"},"SuspendParams":{"description":"Parameters for suspend action.","properties":{"action":{"const":"suspend","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to suspend","items":{"type":"integer"},"title":"Card Ids","type":"array"}},"required":["action","card_ids"],"title":"SuspendParams","type":"object"},"UnburyParams":{"description":"Parameters for unbury action.","properties":{"action":{"const":"unbury","title":"Action","type":"string"},"deck_name":{"description":"Deck name to unbury all cards from","title":"Deck Name","type":"string"}},"required":["action","deck_name"],"title":"UnburyParams","type":"object"},"UnsuspendParams":{"description":"Parameters for unsuspend action.","properties":{"action":{"const":"unsuspend","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to unsuspend","items":{"type":"integer"},"title":"Card Ids","type":"array"}},"required":["action","card_ids"],"title":"UnsuspendParams","type":"object"}},"properties":{"params":{"discriminator":{"mapping":{"bury":"#/$defs/BuryParams","change_deck":"#/$defs/ChangeDeckParams","forget_cards":"#/$defs/ForgetCardsParams","reposition":"#/$defs/RepositionParams","set_due_date":"#/$defs/SetDueDateParams","set_flag":"#/$defs/SetFlagParams","suspend":"#/$defs/SuspendParams","unbury":"#/$defs/UnburyParams","unsuspend":"#/$defs/UnsuspendParams"},"propertyName":"action"},"oneOf":[{"$ref":"#/$defs/RepositionParams"},{"$ref":"#/$defs/ChangeDeckParams"},{"$ref":"#/$defs/BuryParams"},{"$ref":"#/$defs/UnburyParams"},{"$ref":"#/$defs/SuspendParams"},{"$ref":"#/$defs/UnsuspendParams"},{"$ref":"#/$defs/SetFlagParams"},{"$ref":"#/$defs/SetDueDateParams"},{"$ref":"#/$defs/ForgetCardsParams"}],"title":"Params"}},"required":["params"],"title":"card_managementArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"card_managementDictOutput","type":"object"}},{"name":"cards_stats","description":"Bulk per-card scheduling stats for a deck (subdecks included), FSRS-independent. For every matching card returns a compact record: cid, nid, the note's tags, and raw Anki ints for type (0 new, 1 learning, 2 review, 3 relearning) and queue (-3/-2 buried, -1 suspended, 0 new, 1 lrn, 2 rev, 3 day-lrn), plus interval (days) and a computed dueToday flag. No note fields, no HTML, no human-readable names -- just the scheduling metrics, for bulk analytics. Paginated with limit (default 1000, max 1000) and offset; cards are ordered by card id for stable paging. Prefer this over find_notes + notes_info + get_card_memory_state when you only need scheduling metrics: it is one compact read and does not require FSRS.","inputSchema":{"properties":{"deck":{"title":"Deck","type":"string"},"limit":{"default":1000,"title":"Limit","type":"integer"},"offset":{"default":0,"title":"Offset","type":"integer"}},"required":["deck"],"title":"cards_statsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"cards_statsDictOutput","type":"object"}},{"name":"create_deck","description":"Create a new empty Anki deck. Supports parent::child structure (e.g., \"Japanese::Tokyo\" creates parent deck \"Japanese\" and child deck \"Tokyo\"). Maximum 2 levels of nesting allowed. Will not overwrite existing decks. IMPORTANT: This tool ONLY creates an empty deck. DO NOT add cards or notes after creating a deck unless the user EXPLICITLY asks to add them. Wait for user instructions before adding any content. Returns deckId and created flag (false if deck already existed).","inputSchema":{"properties":{"deck_name":{"title":"Deck Name","type":"string"}},"required":["deck_name"],"title":"create_deckArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"create_deckDictOutput","type":"object"}},{"name":"create_model","description":"Create a new note type (model) in Anki with custom fields, card templates, and styling. Useful for creating specialized models like RTL (Right-to-Left) language models for Hebrew, Arabic, etc. Each model defines the structure of notes and how cards are generated from them. Returns model_id, fields list, template_count, and any template warnings.\n\nThe result carries \"will_force_full_sync\": collection state read AFTER the write, reporting whether the NEXT sync will be a one-way full sync that overwrites the collection on AnkiWeb and other devices with this one. It does NOT mean this call caused it -- the flag is collection-wide and sticky, so once any earlier operation marked the schema modified it stays true until a full sync clears it. Creating a note type does not itself modify the schema, so this is typically false unless the collection was already dirty.","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"},"in_order_fields":{"items":{"type":"string"},"title":"In Order Fields","type":"array"},"card_templates":{"items":{"additionalProperties":{"type":"string"},"type":"object"},"title":"Card Templates","type":"array"},"css":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Css"},"is_cloze":{"default":false,"title":"Is Cloze","type":"boolean"}},"required":["model_name","in_order_fields","card_templates"],"title":"create_modelArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"create_modelDictOutput","type":"object"}},{"name":"delete_media_file","description":"Move a media file to Anki's trash folder. The file can be recovered via Anki's 'Check Media' dialog until the trash is emptied. Sync to propagate the deletion to other devices. Confirm with the user before deleting.","inputSchema":{"properties":{"filename":{"title":"Filename","type":"string"}},"required":["filename"],"title":"delete_media_fileArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"delete_media_fileDictOutput","type":"object"}},{"name":"delete_notes","description":"Delete notes by their IDs. This will permanently remove the notes and ALL associated cards. Requires confirmDeletion=true as a safeguard — the call will fail without it. Use dry_run=true to preview what would be deleted without actually deleting anything (confirmDeletion is ignored during dry runs). Returns deletedCount, cardsDeleted, and notFoundCount.","inputSchema":{"properties":{"notes":{"items":{"type":"integer"},"title":"Notes","type":"array"},"confirmDeletion":{"title":"Confirmdeletion","type":"boolean"},"dry_run":{"default":false,"title":"Dry Run","type":"boolean"}},"required":["notes","confirmDeletion"],"title":"delete_notesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"delete_notesDictOutput","type":"object"}},{"name":"filtered_deck","description":"Manage filtered (cram) decks with 5 actions:\n\n    - create_or_update: Create a new filtered deck or update an existing one. Filtered decks temporarily borrow cards from other decks based on search queries. Cards are NOT duplicated -- they are moved temporarily. Max 2 search terms per deck (Anki hard limit). Returns deck_id and card_count. Note: Anki may modify the deck name if it conflicts.\n\n    - rebuild: Empty and re-pull cards matching the deck's search terms. Rebuilding first returns all cards to home decks, then re-searches. Returns card_count after rebuild.\n\n    - empty: Return all cards to their original decks. Card scheduling is preserved.\n\n    - delete: Return all cards to original decks and remove the deck. Cards are NOT deleted -- they go back to their home decks with scheduling intact.\n\n    - get_info: Inspect filtered deck configuration. Returns search terms, limits, order, reschedule setting, and card count for each deck. Non-filtered decks are included with is_filtered=false. Non-existent deck IDs are silently skipped (see not_found count). Max 50 deck IDs per request.","inputSchema":{"$defs":{"CreateOrUpdateParams":{"properties":{"action":{"const":"create_or_update","title":"Action","type":"string"},"deck_id":{"default":0,"description":"0 = create new deck, non-zero = update existing filtered deck","title":"Deck Id","type":"integer"},"name":{"description":"Deck name (e.g., 'Cram Session' or 'Study::Filtered')","title":"Name","type":"string"},"search_terms":{"description":"1-2 search terms defining which cards to pull","items":{"$ref":"#/$defs/SearchTermParam"},"maxItems":2,"minItems":1,"title":"Search Terms","type":"array"},"reschedule":{"default":true,"description":"Update scheduling after review (recommended True)","title":"Reschedule","type":"boolean"},"allow_empty":{"default":true,"description":"Allow creation even if search matches 0 cards. When False, the ENTIRE operation is rolled back if no cards match -- deck is NOT created.","title":"Allow Empty","type":"boolean"}},"required":["action","name","search_terms"],"title":"CreateOrUpdateParams","type":"object"},"DeleteParams":{"properties":{"action":{"const":"delete","title":"Action","type":"string"},"deck_id":{"description":"Filtered deck ID","title":"Deck Id","type":"integer"}},"required":["action","deck_id"],"title":"DeleteParams","type":"object"},"EmptyParams":{"properties":{"action":{"const":"empty","title":"Action","type":"string"},"deck_id":{"description":"Filtered deck ID","title":"Deck Id","type":"integer"}},"required":["action","deck_id"],"title":"EmptyParams","type":"object"},"GetInfoParams":{"properties":{"action":{"const":"get_info","title":"Action","type":"string"},"deck_ids":{"description":"Deck IDs to inspect (max 50)","items":{"type":"integer"},"maxItems":50,"minItems":1,"title":"Deck Ids","type":"array"}},"required":["action","deck_ids"],"title":"GetInfoParams","type":"object"},"RebuildParams":{"properties":{"action":{"const":"rebuild","title":"Action","type":"string"},"deck_id":{"description":"Filtered deck ID","title":"Deck Id","type":"integer"}},"required":["action","deck_id"],"title":"RebuildParams","type":"object"},"SearchTermParam":{"properties":{"search":{"description":"Anki search query (e.g., 'deck:Spanish is:due')","title":"Search","type":"string"},"limit":{"default":100,"description":"Max cards to pull","minimum":1,"title":"Limit","type":"integer"},"order":{"default":"random","description":"Card selection order (default matches Anki GUI)","enum":["oldest_reviewed_first","random","intervals_ascending","intervals_descending","lapses","added","due","reverse_added","retrievability_ascending","retrievability_descending","relative_overdueness"],"title":"Order","type":"string"}},"required":["search"],"title":"SearchTermParam","type":"object"}},"properties":{"params":{"discriminator":{"mapping":{"create_or_update":"#/$defs/CreateOrUpdateParams","delete":"#/$defs/DeleteParams","empty":"#/$defs/EmptyParams","get_info":"#/$defs/GetInfoParams","rebuild":"#/$defs/RebuildParams"},"propertyName":"action"},"oneOf":[{"$ref":"#/$defs/CreateOrUpdateParams"},{"$ref":"#/$defs/RebuildParams"},{"$ref":"#/$defs/EmptyParams"},{"$ref":"#/$defs/DeleteParams"},{"$ref":"#/$defs/GetInfoParams"}],"title":"Params"}},"required":["params"],"title":"filtered_deckArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"filtered_deckDictOutput","type":"object"}},{"name":"find_notes","description":"Search for notes using Anki query syntax. Returns an array of note IDs matching the query. Supports pagination with limit/offset parameters. Maximum limit is 500 per request. Examples: \"deck:Spanish\", \"tag:verb\", \"is:due\", \"front:hello\", \"added:1\" (cards added today), \"prop:due<=2\" (cards due within 2 days), \"flag:1\" (red flag), \"is:suspended\". Set include_first_field=true to also get a 'noteLabels' array of {noteId, firstField} entries (first field excerpted at 250 chars, with truncated/fullLength markers) - one call to find AND label results instead of find_notes followed by notes_info. The labels identify notes; read full content with notes_info before editing. Pass 'noteIds' (not 'noteLabels') to any tool that wants note IDs.","inputSchema":{"properties":{"query":{"title":"Query","type":"string"},"limit":{"default":100,"title":"Limit","type":"integer"},"offset":{"default":0,"title":"Offset","type":"integer"},"include_first_field":{"default":false,"title":"Include First Field","type":"boolean"}},"required":["query"],"title":"find_notesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"find_notesDictOutput","type":"object"}},{"name":"get_card_memory_state","description":"Get FSRS memory state (stability, difficulty, retrievability) for one or more cards. Requires FSRS to be enabled. Returns per-card memory state along with scheduling info. Use recompute=True to recalculate from the review log (slower but ensures accuracy).","inputSchema":{"properties":{"card_ids":{"items":{"type":"integer"},"title":"Card Ids","type":"array"},"recompute":{"default":false,"title":"Recompute","type":"boolean"}},"required":["card_ids"],"title":"get_card_memory_stateArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"get_card_memory_stateDictOutput","type":"object"}},{"name":"get_due_cards","description":"Retrieve the next single card due for review from a specified deck in true scheduler order. IMPORTANT: Use sync tool FIRST before getting cards to ensure latest data. After getting the card, use present_card to show it to the user. Returns one card per call to ensure correct scheduler interleaving. The deck_name parameter is required - you must specify which deck to study. For voice-mode review, use skip_images=True and/or skip_audio=True to filter out cards with media. Cards with media are temporarily buried (removed from queue) and can be unburied later using the card_management tool. Response includes has_images and has_audio flags for each card. deckName is the card's home deck; filteredDeckName is always present and is null unless the card is currently being studied from a filtered deck.","inputSchema":{"properties":{"deck_name":{"title":"Deck Name","type":"string"},"skip_images":{"default":false,"title":"Skip Images","type":"boolean"},"skip_audio":{"default":false,"title":"Skip Audio","type":"boolean"}},"required":["deck_name"],"title":"get_due_cardsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"get_due_cardsDictOutput","type":"object"}},{"name":"get_fsrs_params","description":"Get FSRS scheduler parameters for Anki deck presets. Returns FSRS weights, desired retention, max interval, and other settings. If deck_name is empty, returns parameters for all presets with their associated decks. If deck_name is provided, returns parameters for the preset used by that deck.","inputSchema":{"properties":{"deck_name":{"default":"","title":"Deck Name","type":"string"}},"title":"get_fsrs_paramsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"get_fsrs_paramsDictOutput","type":"object"}},{"name":"get_media_files_names","description":"List all media files in Anki's media folder with optional pattern filtering. Use patterns like '*.mp3' for audio files, '*.jpg' for images, etc.","inputSchema":{"properties":{"pattern":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Pattern"}},"title":"get_media_files_namesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"get_media_files_namesDictOutput","type":"object"}},{"name":"list_decks","description":"List all available Anki decks, optionally with statistics. Remember to sync first at the start of a review session for latest data. Returns deck objects with deck_id, name, and is_filtered. With include_stats=true, adds per-deck card counts (new, learn, review, total).","inputSchema":{"properties":{"include_stats":{"default":false,"title":"Include Stats","type":"boolean"}},"title":"list_decksArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"list_decksDictOutput","type":"object"}},{"name":"model_field_names","description":"Get the field names and descriptions for a specific note type (model). Use this to know what fields are required when creating notes of this type. Returns both field_names (list of strings) and fields (list of objects with name and description).","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"}},"required":["model_name"],"title":"model_field_namesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"model_field_namesDictOutput","type":"object"}},{"name":"model_fields","description":"Manage fields on an existing note type (model). add, remove and reposition change the note type schema, which forces a one-way full sync on the next sync -- this overwrites the collection on AnkiWeb and your other devices. rename only changes a field's name and does NOT itself modify the schema.\n\nThe result carries \"will_force_full_sync\": collection state read AFTER the write, reporting whether the NEXT sync will be a one-way full sync that overwrites the collection on AnkiWeb and other devices with this one. It does NOT mean this call caused it -- the flag is collection-wide and sticky, so once any earlier operation marked the schema modified it stays true until a full sync clears it. add, remove and reposition therefore always report true; rename reports true only if the collection was already dirty.\n\nField management with 3 actions:\n\n    - add: Add a new field to a note type. Optionally position it with a 0-based index (default: appended at the end).\n\n    - rename: Rename an existing field, preserving its content. Card templates are NOT updated automatically -- any reference to {{OldFieldName}} renders blank until you fix it manually with the update_model_templates tool.\n\n    - reposition: Move an existing field to a new 0-based position, reordering the fields of the note type.","inputSchema":{"$defs":{"AddParams":{"properties":{"action":{"const":"add","title":"Action","type":"string"},"model_name":{"description":"Name of the note type (model) to modify","title":"Model Name","type":"string"},"field_name":{"description":"Name of the new field to add","title":"Field Name","type":"string"},"index":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"description":"0-based position for the new field (0..field_count, inclusive). Omit to append at the end.","title":"Index"}},"required":["action","model_name","field_name"],"title":"AddParams","type":"object"},"RenameParams":{"properties":{"action":{"const":"rename","title":"Action","type":"string"},"model_name":{"description":"Name of the note type (model) to modify","title":"Model Name","type":"string"},"field_name":{"description":"Current name of the field to rename","title":"Field Name","type":"string"},"new_name":{"description":"New name for the field","title":"New Name","type":"string"}},"required":["action","model_name","field_name","new_name"],"title":"RenameParams","type":"object"},"RepositionParams":{"properties":{"action":{"const":"reposition","title":"Action","type":"string"},"model_name":{"description":"Name of the note type (model) to modify","title":"Model Name","type":"string"},"field_name":{"description":"Name of the field to move","title":"Field Name","type":"string"},"index":{"description":"0-based target position for the field (0..field_count-1)","title":"Index","type":"integer"}},"required":["action","model_name","field_name","index"],"title":"RepositionParams","type":"object"}},"properties":{"params":{"discriminator":{"mapping":{"add":"#/$defs/AddParams","rename":"#/$defs/RenameParams","reposition":"#/$defs/RepositionParams"},"propertyName":"action"},"oneOf":[{"$ref":"#/$defs/AddParams"},{"$ref":"#/$defs/RenameParams"},{"$ref":"#/$defs/RepositionParams"}],"title":"Params"}},"required":["params"],"title":"model_fieldsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"model_fieldsDictOutput","type":"object"}},{"name":"model_names","description":"Get a list of all available note type (model) names in Anki. Use this to see what note types are available before creating notes. Returns modelNames list and commonTypes shortcuts (basic, basicReversed, cloze).","inputSchema":{"properties":{},"title":"model_namesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"model_namesDictOutput","type":"object"}},{"name":"model_styling","description":"Get the CSS styling for a specific note type (model). This CSS is used when rendering cards of this type. Set include_latex=true to additionally return the model's LaTeX preamble ('latex_pre', 'latex_post', 'latex_svg') -- the header/footer wrapped around [latex] and [$]...[/$] blocks when rendering them. Only ask for it when diagnosing or fixing LaTeX/TikZ rendering; it is omitted by default.","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"},"include_latex":{"default":false,"title":"Include Latex","type":"boolean"}},"required":["model_name"],"title":"model_stylingArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"model_stylingDictOutput","type":"object"}},{"name":"model_templates","description":"Get the card template HTML (Front and Back) for each card type in a note type (model). Returns the raw HTML templates used to render cards during review and editing.","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"}},"required":["model_name"],"title":"model_templatesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"model_templatesDictOutput","type":"object"}},{"name":"notes_info","description":"Get detailed information about specific notes including all fields, tags, model info, and CSS styling. Use this after find_notes to get complete note data. Includes CSS for proper rendering awareness. Use include_fields to return only specific fields, or exclude_fields to omit fields - useful for reducing response size in bulk queries. If both are provided, include_fields takes priority. Use excerpt_chars (>= 1) to cap every returned field value at that many characters; each field then also carries truncated (bool) and fullLength (original character count). Excerpts exist to IDENTIFY notes cheaply, NOT to search their content - content search belongs in find_notes queries, which run server-side over full content. Never use a truncated value as the basis for an edit: re-read the field without excerpt_chars first, otherwise you will write back a cut-off value.","inputSchema":{"properties":{"notes":{"items":{"type":"integer"},"title":"Notes","type":"array"},"include_fields":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Include Fields"},"exclude_fields":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Exclude Fields"},"excerpt_chars":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Excerpt Chars"}},"required":["notes"],"title":"notes_infoArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"notes_infoDictOutput","type":"object"}},{"name":"optimize_fsrs_params","description":"Run FSRS parameter optimization for a deck config preset using Anki's built-in optimizer. This analyzes review history to find optimal FSRS weights. Set apply_results=False (default) for a dry run that shows what the optimized params would be. Set apply_results=True to save the optimized parameters. This operation runs synchronously and typically takes 5-30 seconds depending on review history size. Returns current_params vs optimized_params comparison, already_optimal flag, and applied flag.","inputSchema":{"properties":{"preset_name":{"title":"Preset Name","type":"string"},"apply_results":{"default":false,"title":"Apply Results","type":"boolean"}},"required":["preset_name"],"title":"optimize_fsrs_paramsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"optimize_fsrs_paramsDictOutput","type":"object"}},{"name":"present_card","description":"Retrieve a card's content for review. WORKFLOW: 1) Show question, 2) Wait for user answer, 3) Show answer with show_answer=true, 4) Evaluate and suggest rating (1-4), 5) Wait for user confirmation (\"ok\"/\"next\" = accept, or they provide different rating), 6) Only then use rate_card. Returns a card object with card_id, question (rendered HTML, always returned), answer (rendered HTML, only when show_answer=true), deck_name, filtered_deck_name, note_type, and scheduling fields (interval, ease_factor, due, reviews, lapses). deck_name is the card's home deck; filtered_deck_name is always present and is null unless the card is currently being studied from a filtered deck.","inputSchema":{"properties":{"card_id":{"title":"Card Id","type":"integer"},"show_answer":{"default":false,"title":"Show Answer","type":"boolean"}},"required":["card_id"],"title":"present_cardArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"present_cardDictOutput","type":"object"}},{"name":"rate_card","description":"Submit a rating for a card to update Anki's spaced repetition scheduling. Use this ONLY after the user confirms or modifies your suggested rating. Do not rate automatically without user input. Returns next_review date, new_interval (days for review cards), and card_type.","inputSchema":{"properties":{"card_id":{"title":"Card Id","type":"integer"},"rating":{"title":"Rating","type":"integer"}},"required":["card_id","rating"],"title":"rate_cardArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"rate_cardDictOutput","type":"object"}},{"name":"set_fsrs_params","description":"Update FSRS parameters on a deck config preset. Can set FSRS weights, desired retention (0.70-0.99), and/or max interval. At least one parameter must be changed. Returns old/new diff for each changed field. Use get_fsrs_params first to see current values.","inputSchema":{"properties":{"preset_name":{"title":"Preset Name","type":"string"},"fsrs_params":{"anyOf":[{"items":{"type":"number"},"type":"array"},{"type":"null"}],"default":null,"title":"Fsrs Params"},"desired_retention":{"default":-1.0,"title":"Desired Retention","type":"number"},"max_interval":{"default":-1,"title":"Max Interval","type":"integer"}},"required":["preset_name"],"title":"set_fsrs_paramsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"set_fsrs_paramsDictOutput","type":"object"}},{"name":"store_media_file","description":"Store a media file to Anki's collection.media folder. Accepts files via base64 data, local file path, or URL. Use this to add images, audio, or other media files that can be referenced in note fields. Returns the stored filename and full path.","inputSchema":{"properties":{"filename":{"title":"Filename","type":"string"},"data":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Data"},"path":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Path"},"url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Url"}},"required":["filename"],"title":"store_media_fileArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"store_media_fileDictOutput","type":"object"}},{"name":"sync","description":"Synchronize the local Anki collection with AnkiWeb. This is an ASYNCHRONOUS job: one tool, three call shapes, driven by which arguments you pass.\n\nTHE THREE CALL SHAPES:\n  1. sync()                     -> start a sync\n  2. sync(job_id=\"...\")         -> check that sync's progress/result\n  3. sync(job_id=\"...\", resolve=\"upload\"|\"download\"|\"cancel\") -> resolve a conflict\n\nSTEP 1 -- START. Call sync with NO arguments. You get back {job_id, status:'running'}. The sync is NOT finished yet -- 'running' only means it has begun. Keep the job_id.\n\nSTEP 2 -- POLL until done. Call sync AGAIN passing ONLY that job_id (sync(job_id=\"...\")). This returns the job's status snapshot. Do NOT assume the sync is done after one poll -- poll a few times until status becomes one of the FOUR terminal values: 'success', 'error', 'conflict', or 'cancelled'. While status is still 'running', wait briefly and poll again.\n\nSTEP 3 -- HANDLE the terminal status:\n  * 'success'   -> done, the collection is in sync. Nothing more to do.\n  * 'conflict'  -> a one-way full sync is required. Look at the snapshot's legal_directions and call sync with the job_id AND resolve set to one of them: resolve='upload' pushes LOCAL -> AnkiWeb (your computer wins), resolve='download' pulls AnkiWeb -> LOCAL (the server wins). WARNING: the wrong direction PERMANENTLY DISCARDS the data on the losing side. Only pass a direction that appears in legal_directions. If you are unsure which side is correct, call sync with the job_id and resolve='cancel' to abandon safely -- nothing is transferred, the collection is left untouched, and a fresh sync() can be started later. After resolve='upload'/'download' you get a new {status:'running'} -- go back to STEP 2 and poll again.\n  * 'error'     -> inspect error.code. error.code=='auth_failed' means the AnkiWeb login expired or failed and the USER must re-authenticate (in Anki: Tools > Preferences, or the Sync button) before a new sync will work. error.hint (when present) is a human-readable next step.\n  * 'cancelled' -> a conflict was abandoned; nothing was transferred.\n\nGUARDRAILS: resolve REQUIRES a job_id (calling sync with resolve but no job_id is an error -- resolve needs a job to act on). An unknown or expired job_id returns a not_found error.\n\nSNAPSHOT FIELDS returned by sync(job_id): status (running|conflict|success|error|cancelled), phase (checking|full_transfer|media|done), legal_directions (the resolve options, only when status=='conflict'), required (only when status=='conflict': the ChangesRequired name that forced the full sync; null otherwise), result (on success), error ({code, message, category, hint} on error), job_id, started_at, finished_at.\n\nRESULT FIELDS (on status=='success'): result.outcome is the backend's post-sync state -- 'NO_CHANGES' (nothing to transfer) or 'NORMAL_SYNC' (changes were transferred); either way the sync is COMPLETE and nothing further is required. Do NOT confuse it with the top-level 'required' field, which is only populated for conflicts (null otherwise). On the resolve path result carries resolved:true instead of outcome. result.media_error is null when media synced fine, or an error payload when media failed -- media is best-effort and never fails the collection sync itself.\n\nTIP: sync at the START of a review session (before fetching cards) and at the END when the user is done, so all devices stay consistent.","inputSchema":{"properties":{"job_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Job Id"},"resolve":{"anyOf":[{"enum":["upload","download","cancel"],"type":"string"},{"type":"null"}],"default":null,"title":"Resolve"}},"title":"syncArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"syncDictOutput","type":"object"}},{"name":"tag_management","description":"Manage tags on notes with 6 actions:\n\n    - add_tags: Add tags to notes by note IDs. Tags: space-separated tag names (e.g., 'vocab grammar'). Returns added_count.\n\n    - remove_tags: Remove tags from notes by note IDs. Tags: space-separated tag names to remove. Returns removed_count.\n\n    - replace_tags: Replace a tag with another on specific notes. Adds new_tag then removes old_tag on the given notes. Returns added_count and removed_count.\n\n    - get_tags: List all tags in the collection. Optional deck param scopes results to tags on notes with at least one card in that deck (subdecks included); omit for all collection tags. Returns tags array and count.\n\n    - clear_unused_tags: Remove tags that are not used by any notes. No parameters needed. Returns cleared_count.\n\n    - batch_tags: Apply multiple add/remove tag operations in a single call. Each operation specifies type ('add' or 'remove'), note_ids, and tags. Operations execute in order with partial success support. Max 50 operations. Returns per-operation results with affected_count, plus succeeded/failed totals.","inputSchema":{"$defs":{"AddTagsParams":{"description":"Parameters for add_tags action.","properties":{"action":{"const":"add_tags","title":"Action","type":"string"},"note_ids":{"description":"Note IDs to add tags to","items":{"type":"integer"},"title":"Note Ids","type":"array"},"tags":{"description":"Space-separated tag names to add (e.g., 'vocab grammar')","title":"Tags","type":"string"}},"required":["action","note_ids","tags"],"title":"AddTagsParams","type":"object"},"BatchTagsParams":{"description":"Parameters for batch_tags action.","properties":{"action":{"const":"batch_tags","title":"Action","type":"string"},"operations":{"description":"List of tag operations. Each has: type ('add'/'remove'), note_ids (list of ints), tags (space-separated string). Executed in order.","items":{"$ref":"#/$defs/TagOperation"},"title":"Operations","type":"array"}},"required":["action","operations"],"title":"BatchTagsParams","type":"object"},"ClearUnusedTagsParams":{"description":"Parameters for clear_unused_tags action.","properties":{"action":{"const":"clear_unused_tags","title":"Action","type":"string"}},"required":["action"],"title":"ClearUnusedTagsParams","type":"object"},"GetTagsParams":{"description":"Parameters for get_tags action.","properties":{"action":{"const":"get_tags","title":"Action","type":"string"},"deck":{"default":"","description":"Optional deck name to scope tags to notes with a card in this deck (subdecks included). Omit or leave empty for all collection tags.","title":"Deck","type":"string"}},"required":["action"],"title":"GetTagsParams","type":"object"},"RemoveTagsParams":{"description":"Parameters for remove_tags action.","properties":{"action":{"const":"remove_tags","title":"Action","type":"string"},"note_ids":{"description":"Note IDs to remove tags from","items":{"type":"integer"},"title":"Note Ids","type":"array"},"tags":{"description":"Space-separated tag names to remove (e.g., 'vocab grammar')","title":"Tags","type":"string"}},"required":["action","note_ids","tags"],"title":"RemoveTagsParams","type":"object"},"ReplaceTagsParams":{"description":"Parameters for replace_tags action.","properties":{"action":{"const":"replace_tags","title":"Action","type":"string"},"note_ids":{"description":"Note IDs to replace tags on","items":{"type":"integer"},"title":"Note Ids","type":"array"},"old_tag":{"description":"Tag to remove","title":"Old Tag","type":"string"},"new_tag":{"description":"Tag to add in place of old_tag","title":"New Tag","type":"string"}},"required":["action","note_ids","old_tag","new_tag"],"title":"ReplaceTagsParams","type":"object"},"TagOperation":{"description":"A single tag operation within a batch.","properties":{"type":{"description":"Operation type: 'add' to add tags, 'remove' to remove tags","enum":["add","remove"],"title":"Type","type":"string"},"note_ids":{"description":"Note IDs to apply this operation to","items":{"type":"integer"},"title":"Note Ids","type":"array"},"tags":{"description":"Space-separated tag names (e.g., 'vocab grammar')","title":"Tags","type":"string"}},"required":["type","note_ids","tags"],"title":"TagOperation","type":"object"}},"properties":{"params":{"discriminator":{"mapping":{"add_tags":"#/$defs/AddTagsParams","batch_tags":"#/$defs/BatchTagsParams","clear_unused_tags":"#/$defs/ClearUnusedTagsParams","get_tags":"#/$defs/GetTagsParams","remove_tags":"#/$defs/RemoveTagsParams","replace_tags":"#/$defs/ReplaceTagsParams"},"propertyName":"action"},"oneOf":[{"$ref":"#/$defs/AddTagsParams"},{"$ref":"#/$defs/RemoveTagsParams"},{"$ref":"#/$defs/ReplaceTagsParams"},{"$ref":"#/$defs/GetTagsParams"},{"$ref":"#/$defs/ClearUnusedTagsParams"},{"$ref":"#/$defs/BatchTagsParams"}],"title":"Params"}},"required":["params"],"title":"tag_managementArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"tag_managementDictOutput","type":"object"}},{"name":"update_model_styling","description":"Update the CSS styling (and optionally the LaTeX preamble) of an existing note type (model). Changes apply to all cards using this model.\n\nTWO MUTUALLY EXCLUSIVE CSS INPUT MODES -- use exactly one, or neither when only writing LaTeX fields:\n  1. FULL REPLACE: pass 'css' with the complete new stylesheet.\n  2. PATCH: pass 'old_str' + 'new_str' to replace a snippet in place, like a text editor's find-and-replace. 'old_str' must match the current CSS EXACTLY ONCE (whitespace is significant); 0 matches or 2+ matches is an error and nothing is written. On a 0-match error the response includes an excerpt of the current CSS so you can correct 'old_str' and retry without a separate read. Prefer PATCH for small edits -- it avoids resending the whole stylesheet and cannot silently clobber concurrent changes.\n  TRANSPORT CAVEAT: if 'old_str' or 'new_str' would consist ENTIRELY of a JSON value -- exactly `null`, or a complete JSON array/object such as `[\"x\"]` or `{\"a\": 1}` -- it can be mis-read in transit and the call rejected. Include an adjacent character of surrounding context in the string to avoid it.\n\nOPTIONAL LATEX PREAMBLE: 'latex_pre', 'latex_post' and 'latex_svg' set the LaTeX header/footer/SVG-rendering flag used when rendering [latex] and [$]...[/$] blocks. Only the ones you pass are written, and they combine with either CSS mode or can be sent alone. Use them to fix [latex]/TikZ rendering (e.g. adding \\usepackage{tikz} to 'latex_pre'). Most models never need these -- leave them out unless LaTeX is actually broken. Read the current values with model_styling(include_latex=true).\n\nThe result carries \"will_force_full_sync\": collection state read AFTER the write, reporting whether the NEXT sync will be a one-way full sync that overwrites the collection on AnkiWeb and other devices with this one. It does NOT mean this call caused it -- the flag is collection-wide and sticky, so once any earlier operation marked the schema modified it stays true until a full sync clears it. Editing CSS or the LaTeX preamble does not itself modify the schema, so this is typically false unless the collection was already dirty.","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"},"css":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Css"},"old_str":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Old Str"},"new_str":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"New Str"},"latex_pre":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Latex Pre"},"latex_post":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Latex Post"},"latex_svg":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Latex Svg"}},"required":["model_name"],"title":"update_model_stylingArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"update_model_stylingDictOutput","type":"object"}},{"name":"update_model_templates","description":"Update the card template HTML (Front/Back) of a note type (model). Changes apply to all future renders; existing cards keep their generated content but will use the new template on next render.\n\nTWO MUTUALLY EXCLUSIVE INPUT MODES -- use exactly one:\n  1. FULL REPLACE: pass 'templates' as {card template name: {'Front': html, 'Back': html}}. Front/Back are optional per template but replace the whole side. Multiple templates can be updated in one call.\n  2. PATCH: pass 'template_name' + 'side' ('Front' or 'Back') + 'old_str' + 'new_str' to replace a snippet in place, like a text editor's find-and-replace. 'old_str' must match that side's current HTML EXACTLY ONCE (whitespace is significant); 0 matches or 2+ matches is an error and nothing is written. On a 0-match error the response includes an excerpt of the current HTML so you can correct 'old_str' and retry without a separate read. Patch mode touches exactly one side of one template. Prefer PATCH for small edits -- it avoids resending the whole template and cannot silently clobber concurrent changes.\n  TRANSPORT CAVEAT: if 'old_str' or 'new_str' would consist ENTIRELY of a JSON value -- exactly `null`, or a complete JSON array/object such as `[\"x\"]` or `{\"a\": 1}` -- it can be mis-read in transit and the call rejected. Include an adjacent character of surrounding context in the string to avoid it.\n\nUse model_templates to read current template names and HTML.\n\nThe result carries \"will_force_full_sync\": collection state read AFTER the write, reporting whether the NEXT sync will be a one-way full sync that overwrites the collection on AnkiWeb and other devices with this one. It does NOT mean this call caused it -- the flag is collection-wide and sticky, so once any earlier operation marked the schema modified it stays true until a full sync clears it. Editing the HTML of existing card templates does not itself modify the schema, so this is typically false unless the collection was already dirty.","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"},"templates":{"anyOf":[{"additionalProperties":{"additionalProperties":{"type":"string"},"type":"object"},"type":"object"},{"type":"null"}],"default":null,"title":"Templates"},"template_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Template Name"},"side":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Side"},"old_str":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Old Str"},"new_str":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"New Str"}},"required":["model_name"],"title":"update_model_templatesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"update_model_templatesDictOutput","type":"object"}},{"name":"update_note_fields","description":"Update the fields of an existing note. Supports HTML content in fields and preserves CSS styling.\n\nTWO MUTUALLY EXCLUSIVE INPUT MODES -- use exactly one:\n  1. FULL REPLACE: pass 'fields' as {field name: new full value}. Each listed field is overwritten entirely; fields you omit are left alone.\n  2. PATCH: pass 'field_name' + 'old_str' + 'new_str' to replace a snippet in place, like a text editor's find-and-replace. 'old_str' must match that field's current value EXACTLY ONCE (whitespace and HTML markup are significant); 0 matches or 2+ matches is an error and nothing is written. On a 0-match error the response includes an excerpt of the current value so you can correct 'old_str' and retry without a separate read. Patch mode touches exactly one field. Prefer PATCH for small edits to long fields -- it avoids resending the whole value and cannot silently clobber concurrent changes.\n  TRANSPORT CAVEAT: if 'old_str' or 'new_str' would consist ENTIRELY of a JSON value -- exactly `null`, or a complete JSON array/object such as `[\"x\"]` or `{\"a\": 1}` -- it can be mis-read in transit and the call rejected. Include an adjacent character of surrounding context in the string to avoid it.\n\nNote: media file attachment (audio/picture) is not yet supported. WARNING: Do not view the note in Anki browser while updating, or the fields will not update properly. Close the browser or switch to a different note before updating. IMPORTANT: Only update notes that the user explicitly asked to modify.","inputSchema":{"properties":{"id":{"title":"Id","type":"integer"},"fields":{"anyOf":[{"additionalProperties":{"type":"string"},"type":"object"},{"type":"null"}],"default":null,"title":"Fields"},"field_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Field Name"},"old_str":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Old Str"},"new_str":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"New Str"}},"required":["id"],"title":"update_note_fieldsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"update_note_fieldsDictOutput","type":"object"}},{"name":"update_notes","description":"Update the fields of multiple existing notes in a single batch. Each entry must include the note ID and the fields to update (partial updates are fine - only specified fields are changed). Failures for individual notes do not affect others. Use dry_run=true to validate all entries and preview which notes would be updated without writing any changes — useful before committing a large bulk edit. IMPORTANT: Only update notes that the user explicitly asked to modify. Returns summary counts (updated, failed) and a per-note results array with retry hints for recoverable failures.","inputSchema":{"$defs":{"NoteUpdateEntry":{"description":"A single note to update in a batch.","properties":{"id":{"description":"The note ID to update","title":"Id","type":"integer"},"fields":{"additionalProperties":{"type":"string"},"description":"Field values to update as key-value pairs (e.g., {\"Front\": \"new question\", \"Back\": \"new answer\"}). Only specified fields are changed; partial updates are OK.","title":"Fields","type":"object"}},"required":["id","fields"],"title":"NoteUpdateEntry","type":"object"}},"properties":{"notes":{"items":{"$ref":"#/$defs/NoteUpdateEntry"},"title":"Notes","type":"array"},"dry_run":{"default":false,"title":"Dry Run","type":"boolean"}},"required":["notes"],"title":"update_notesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"update_notesDictOutput","type":"object"}},{"name":"gui_add_cards","description":"Open Anki Add Cards dialog. IMPORTANT: Only use when user explicitly requests opening the Add Cards dialog. This tool simply opens the dialog for manual note creation - it does not pre-fill any fields. For programmatic note creation, use add_note instead.","inputSchema":{"properties":{},"title":"gui_add_cardsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_add_cardsDictOutput","type":"object"}},{"name":"gui_browse","description":"Open Anki Card Browser and search for cards using Anki query syntax. Returns array of card IDs found. IMPORTANT: Only use when user explicitly requests opening the browser. This tool is for note editing/creation workflows, NOT for review sessions. Use this to find and select cards/notes that need editing.","inputSchema":{"properties":{"query":{"title":"Query","type":"string"}},"required":["query"],"title":"gui_browseArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_browseDictOutput","type":"object"}},{"name":"gui_current_card","description":"Get the card currently displayed in Anki's reviewer window: question and answer HTML, fields, note ID, card ID, deck name, note type, and the next-review interval behind each answer button. deckName is the card's home deck; filteredDeckName is always present and is null unless the card is currently being studied from a filtered deck. Returns inReview=false when the reviewer is not active. Use this when the user is reviewing in Anki's GUI and asks about the card in front of them (for example 'explain this card'), or to find the note behind it before editing. Read-only: while the user is reviewing in Anki's own reviewer, never answer or rate cards for them, not with GUI tools and not with rate_card, the user presses the answer buttons. get_due_cards, present_card and rate_card are for AI-driven review sessions outside the GUI reviewer.","inputSchema":{"properties":{},"title":"gui_current_cardArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_current_cardDictOutput","type":"object"}},{"name":"gui_deck_browser","description":"Open Anki Deck Browser dialog showing all decks. IMPORTANT: Only use when user explicitly requests opening the deck browser. This tool is for deck management and organization workflows, NOT for review sessions. Use this when user wants to see all decks or manage deck structure.","inputSchema":{"properties":{},"title":"gui_deck_browserArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_deck_browserDictOutput","type":"object"}},{"name":"gui_edit_note","description":"Open Anki note editor dialog for a specific note ID. Allows manual editing of note fields, tags, and cards in the GUI. The note editor is opened in the Anki Browser, which provides full editing capabilities. IMPORTANT: Only use when user explicitly requests editing a note via GUI. This tool is for note editing workflows when user wants to manually edit in the Anki interface. For programmatic editing, use update_note_fields instead.","inputSchema":{"properties":{"note_id":{"title":"Note Id","type":"integer"}},"required":["note_id"],"title":"gui_edit_noteArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_edit_noteDictOutput","type":"object"}},{"name":"gui_select_card","description":"Select a specific card in an open Card Browser window. Returns true if browser is open and card was selected, false if browser is not open. IMPORTANT: Only use when user explicitly requests selecting a card in the browser. This tool is for note editing/creation workflows, NOT for review sessions. The Card Browser must already be open (use gui_browse first).","inputSchema":{"properties":{"card_id":{"title":"Card Id","type":"integer"}},"required":["card_id"],"title":"gui_select_cardArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_select_cardDictOutput","type":"object"}},{"name":"gui_show_answer","description":"Flip the card currently on screen in Anki's reviewer to its answer side. Returns inReview=false when the reviewer is not active. Use this when the user is reviewing in Anki's GUI and asks to reveal or flip the card in front of them. This only changes what is displayed: while the user is reviewing in Anki's own reviewer, never answer or rate cards for them, not with GUI tools and not with rate_card, the user presses the answer buttons. get_due_cards, present_card and rate_card are for AI-driven review sessions outside the GUI reviewer.","inputSchema":{"properties":{},"title":"gui_show_answerArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_show_answerDictOutput","type":"object"}},{"name":"gui_show_question","description":"Show the question side of the card currently on screen in Anki's reviewer. Returns inReview=false when the reviewer is not active. Use this when the user is reviewing in Anki's GUI and asks to go back to the question side of the card in front of them. This only changes what is displayed: while the user is reviewing in Anki's own reviewer, never answer or rate cards for them, not with GUI tools and not with rate_card, the user presses the answer buttons. get_due_cards, present_card and rate_card are for AI-driven review sessions outside the GUI reviewer.","inputSchema":{"properties":{},"title":"gui_show_questionArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_show_questionDictOutput","type":"object"}},{"name":"gui_undo","description":"Undo the last action or card in Anki. Returns true if undo succeeded, false otherwise. IMPORTANT: Only use when user explicitly requests undoing an action. This tool is for note editing/creation workflows, NOT for review sessions. Use this to undo mistakes in note creation, editing, or card management.","inputSchema":{"properties":{},"title":"gui_undoArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_undoDictOutput","type":"object"}}]}}

